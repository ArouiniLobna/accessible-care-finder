# ---------- API (apps/api) ----------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# Matches docker-compose.yml. Never commit real credentials.
DATABASE_URL=postgres://care:care@localhost:5432/care_finder
# Used by `pnpm test:integration`. The suite truncates and reseeds this database.
TEST_DATABASE_URL=postgres://care:care@localhost:5432/care_finder_test
DATABASE_POOL_MAX=10

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Demo-only routes (/api/demo/*) and the /demo-controls page.
# Would never be enabled on a public production deployment.
ENABLE_DEMO_CONTROLS=true

# Development-only artificial latency so loading/refresh/cancellation states are visible.
# Set both to 0 to disable. Ignored when NODE_ENV=production.
DEMO_LATENCY_MIN_MS=0
DEMO_LATENCY_MAX_MS=0

# Interactive OpenAPI docs at /docs (disabled automatically in production).
ENABLE_API_DOCS=true

# SSE heartbeat comment interval.
SSE_HEARTBEAT_MS=15000

# ---------- Web (apps/web) ----------
# Vite only exposes variables prefixed with VITE_.
# Leave empty in development: Vite proxies /api to the API (see vite.config.ts).
VITE_API_BASE_URL=
VITE_ENABLE_DEMO_CONTROLS=true
