{
  "name": "@acf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/scripts/reset.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@acf/contracts": "workspace:*",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.41",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "drizzle-kit": "^0.31.6",
    "vite": "^7.1.12",
    "esbuild": "^0.25.11",
    "vitest": "^4.0.0"
  }
}
