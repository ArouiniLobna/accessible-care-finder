{
  "name": "@acf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/scripts/reset.ts"
  },
  "dependencies": {
    "@acf/contracts": "workspace:*",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.41",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "drizzle-kit": "^0.31.6"
  }
}
